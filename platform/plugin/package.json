{
  "name": "@ai-agent-harness/harness-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Research Mode 智能体、实例与 MCP 研究工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "pnpm run check && node build.mjs",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-web-app": "0.2.1-alpha.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-web-app": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.5.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "js-yaml": "4.3.2",
    "react-dom": "18.3.1",
    "zod": "4.2.0"
  }
}
