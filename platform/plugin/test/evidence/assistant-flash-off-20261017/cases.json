          {
            "id": "extraction",
            "context": {
              "page": "evaluation",
              "agent_id": "inspection-delivery-demo",
              "experiment_id": "EXP-inspection-delivery-demo-001-rf841e4415364",
              "run_id": "run-05973a80-6b91-40e7-a0da-acca3a4ea696",
              "skill": "decision-sample-extraction"
            },
            "task": "请从当前运行轨迹抽取适合训练的决策样本并保存，优先选择真实业务分歧。问题、选项或评分说明、判断依据等面向人的JSON字段值用中文；字段名、协议枚举、ID和原始动作名称保持合同要求。不要把动作后的结果放进决策前状态，也不要把AI建议当作人员复核。",
            "assertions": [
              "真实固定Run有非空候选自动保存回读",
              "无awaiting_confirmation且无assistant/confirm请求",
              "source摘要、decision_id与实际切片一致",
              "题目及说明等自然语言字段为中文；技术枚举/ID/来源原文保留",
              "suggested、未人工复核、unassigned；训练导出拒绝或有效数为0",
              "已知事后回复评分反例不得混入"
            ],
            "allowed_confirm_actions": [],
            "budget": {
              "max_model_calls": 20,
              "timeout_minutes": 5
            }
          },
          {
            "id": "mcp",
            "context": {
              "page": "mcp",
              "skill": "mcp-composition"
            },
            "task": "请用已接入的只读Mock资产和告警查询工具，创建一个名为“小模型验收资产告警查询”的组合，工具名hep_small_model_asset_alerts。输入资产ID和告警数量上限，先查资产，再查询该资产相关告警，返回资产和告警摘要。用资产9106、上限5试运行，通过后发布并实际调用一次。所有操作只限这个新组合；这是基础模拟数据，不做设备修改。",
            "assertions": [
              "新组合toolName固定且不覆盖既有组合",
              "dryRun实际图和参数校验通过，不将其当作上游服务调用",
              "发布固定版本并真实callPublishedComposition",
              "Run回执有两个只读外部接口成功证据",
              "保存/发布/调用按原生确认，不确认其他对象"
            ],
            "allowed_confirm_actions": [
              "saveCompositionDraft",
              "publishComposition",
              "callPublishedComposition",
              "callTool"
            ],
            "budget": {
              "max_model_calls": 20,
              "timeout_minutes": 5
            },
            "verified_input": {
              "asset": "9106",
              "limit": 5,
              "preflight": "mock-asset-preflight.json"
            },
            "readonly_probe": {
              "serverId": "mock-soc-readonly",
              "toolName": "list_detect_alert",
              "arguments": {
                "req": {
                  "assetId": "9106",
                  "pageNum": 1,
                  "pageSize": 5,
                  "windowSeconds": 2592000
                }
              }
            }
          },
          {
            "id": "compute",
            "context": {
              "page": "agents",
              "tab": "compute-variants",
              "agent_id": "inspection-delivery-demo",
              "experiment_id": "EXP-inspection-delivery-demo-001-rf841e4415364",
              "skill": "compute-variant-research",
              "workflow": "compute-variants"
            },
            "task": "请基于当前基础台账巡检版本策划并派生一个算力变体，名称“分页流程精简”。父版固定为git:9d3e6a834369c292a6318416c1d5ec10c3726a2f中的EXP-inspection-delivery-demo-001-rf841e4415364。目标是保留五台资产完整分页和漏页时拒绝完整交付的行为，探索减少重复模型决策；冻结U-ASSET-PAGES-001和U-ASSET-PARTIAL-001为关键用例，每项至少2次，质量下降容许0个百分点，总token目标下降10%。本轮先形成可检查计划并派生，回读实际保存的父版、计划及新版本；暂不宣称等效或设置end。",
            "assertions": [
              "实际compute-variants/context和preview成功",
              "确认只创建本轮新变体",
              "回读新版本有固定父引用和冻结两Case摘要",
              "没有真实两侧比较不得宣称等效、节省成立或end"
            ],
            "allowed_confirm_actions": [
              "compute-variants/create"
            ],
            "budget": {
              "max_model_calls": 20,
              "timeout_minutes": 5
            }
          },
          {
            "id": "builder",
            "context": {
              "page": "agents",
              "skill": "task-builder",
              "agent_id": "daily-inspection-assistant",
              "experiment_id": "EXP-daily-inspection-assistant-001-r602ec12fd531",
              "reference_sources": [
                "experiment:EXP-daily-inspection-assistant-002-r9eba480e9d2a"
              ],
              "evaluation_case_ids": [
                "U-IDENTITY-001",
                "U-ASSET-PAGES-001",
                "U-ASSET-PARTIAL-001"
              ],
              "expected_device_ids": [
                "asset-0001",
                "asset-0002",
                "asset-0003",
                "asset-0004",
                "asset-0005"
              ],
              "instance_name": "hep-small-model-inspection",
              "instance_port": 3125,
              "artifact_filename": "inspection-report.md"
            },
            "task": "请把日常巡检整理助手构建成可用的只读基础资产台账巡检智能体，优先复用已有参考能力，从所选旧版建立独立研究版本。必须处理所有分页，交付包含asset-0001到asset-0005五台资产的逐设备Markdown和CSV报告及实际下载入口，明确是模拟台账、没有检测真实设备。固定评测身份、完整分页和漏页不得完整交付三个用例，不降低标准。首次评测后如失败，最多3轮分析问题、修改、复测，总模型调用最多60次、总时间30分钟；保留失败证据。通过后启动本轮独立实例并验证使用；条件不足则如实停止并说明。",
            "assertions": [
              "基于固定来源创建隔离新版本，父版不改写",
              "实际业务工具分页覆盖五台资产，报告可下载且含五ID",
              "真实固定三Case初测和必要复测；Case正文hash不变",
              "修复次数<=3、模型预算<=60、停止保留失败",
              "目标实例名/端口限定本轮；交付不是仅创建角色",
              "真实助手和目标业务模型请求分别核对Flash/off"
            ],
            "allowed_confirm_actions": [
              "start"
            ],
            "budget": {
              "max_model_calls": 60,
              "timeout_minutes": 30,
              "max_repair_rounds": 3
            },
            "depends_on": [
              "general",
              "mcp"
            ]
          },
          {
            "id": "operations",
            "context": {
              "page": "instances",
              "skill": "workspace-management"
            },
            "task": "请核对本轮hep-small-model-inspection实例是否可用，读取它的实际状态和日志，提供访问入口并说明所装载版本。仅操作这个隔离实例；若它已成功交付，请提交一次停止再启动的操作，并在启动后重新核对状态。不要操作其他实例。",
            "assertions": [
              "仅本轮独立实例，实际list/url/logs读取",
              "停止/启动原生确认绑定准确名称和来源",
              "重启后健康及所装载版本一致",
              "正式三个业务容器身份和状态不变"
            ],
            "allowed_confirm_actions": [
              "run"
            ],
            "depends_on": [
              "builder"
            ],
            "budget": {
              "max_model_calls": 20,
              "timeout_minutes": 5
            }
          }
        ],
        "constraints": [
          "只在hep-small-model-data及3124/3125隔离环境执行",
