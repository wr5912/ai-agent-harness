#!/usr/bin/env python3
"""准备和前台启动使用全局 DSH 的研究资产平台。"""

import argparse
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import secrets
import socket
import subprocess
import sys
import tempfile
from urllib.parse import quote, unquote, urlparse

REPO = Path(__file__).resolve().parent.parent
PLUGIN = REPO / "platform" / "plugin"
PROFILE_NAME = "harness-platform"
PROFILE_FILES = ("package.json", "cordis.patch.yml", "pnpm-workspace.yaml")
PLATFORM_PATCH = "harness-platform.patch.yml"
WEB = REPO / "runtime" / "adapters" / "dsh-web"


def base_path():
    value = json.loads((asset_root() / "config" / "sites.json").read_text(encoding="utf-8"))["platform"]
    if not re.fullmatch(r"/[a-z][a-z0-9-]*/", value):
        raise PlatformError("工作区 config/sites.json 的 platform 基址无效。")
    return value


class PlatformError(Exception):
    pass


def asset_root():
    sys.path.insert(0, str(REPO / "runtime/adapters/dsh-container"))
    from workspace_paths import asset_root as selected_asset_root
    try:
        return selected_asset_root()
    except (OSError, ValueError):
        raise PlatformError("无法读取部署定位文件 ~/.config/harness-engineering-platform/workspace.json。") from None


def platform_home():
    return (asset_root() / ".local" / "platform-home").resolve()


def check_workspace():
    descriptor = asset_root() / "workspace.json"
    try:
        value = json.loads(descriptor.read_text(encoding="utf-8"))
        if value.get("schemaVersion") != 1 or not re.fullmatch(r"workspace-[a-zA-Z0-9-]+", value.get("id", "")):
            raise ValueError()
    except (OSError, ValueError, TypeError, AttributeError):
        raise PlatformError(f"无法读取工作区身份：{descriptor}；请先准备独立数据工作区。") from None
    return value


def runtime_environment(home):
    environment = dict(os.environ)
    credentials = asset_root() / ".local" / "credentials" / "models.llm-api-key"
    if credentials.exists():
        try:
            values = json.loads(credentials.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            raise PlatformError("无法读取本地模型凭据 JSON 文件。") from None
        if not isinstance(values, dict):
            raise PlatformError("本地模型凭据必须是 JSON 字段映射。")
        for name in ("DEEPSEEK_API_KEY", "LOCAL_LLM_BASE_URL", "LOCAL_LLM_API_KEY"):
            if name not in values or name in environment:
                continue
            if not isinstance(values[name], str) or not values[name].strip():
                raise PlatformError(f"本地模型凭据字段 {name} 必须是非空字符串。")
            environment[name] = values[name]
    return {**environment, "DSH_HOME": str(home), "HARNESS_ASSET_ROOT": str(asset_root()),
            "HARNESS_PROGRAM_ROOT": str(REPO),
            "HARNESS_PYTHON": sys.executable,
            "HARNESS_SITES_CONFIG": str(asset_root() / "config" / "sites.json")}


def global_dsh(home):
    executable = shutil.which("dsh")
    if not executable:
        raise PlatformError("PATH 中没有全局 dsh；请先安装系统全局 DSH。")
    try:
        result = subprocess.run(
            [executable, "--version"], capture_output=True, text=True,
            env=runtime_environment(home), check=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise PlatformError("无法读取全局 dsh 版本。") from exc
    version = result.stdout.strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+(?:-[\w.-]+)?(?:\+[\w.-]+)?", version):
        raise PlatformError("全局 dsh --version 未返回有效版本。")
    manifest_path = PLUGIN / "package.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        peers = manifest["peerDependencies"]
        requirements = {name: value for name, value in peers.items()
                        if name.startswith("@deepseek-ai/dsh-")}
    except (OSError, ValueError, KeyError, AttributeError) as exc:
        raise PlatformError(f"无法读取插件兼容声明：{manifest_path}") from exc
    if not requirements:
        raise PlatformError("插件没有声明 DSH API peerDependencies。")
    incompatible = [f"{name}={required}" for name, required in requirements.items()
                    if required != version]
    if incompatible:
        raise PlatformError(
            f"全局 DSH {version} 与插件精确 peerDependencies 不兼容："
            + ", ".join(incompatible)
        )
    return str(Path(executable).absolute()), version


def rendered_profile():
    skill_dirs = [REPO / "platform/skills", asset_root() / ".local/build-cache/management-skills"]
    skill_dirs += [asset_root() / item["path"] / "skills" for item in workspace_extensions()
                   if (asset_root() / item["path"] / "skills").is_dir()]
    result = {}
    for name in PROFILE_FILES:
        path = REPO / "platform" / "profile" / name
        try:
            source = path.read_text(encoding="utf-8")
        except OSError as exc:
            raise PlatformError(f"缺少平台 Profile 模板：{path}") from exc
        # JSON 字符串同样是合法 YAML 标量，可保留空格、引号等路径字符。
        runtime_name = PLATFORM_PATCH if name == "cordis.patch.yml" else name
        result[runtime_name] = source.replace(
            "{{HARNESS_PLATFORM_PLUGIN}}", json.dumps(str(PLUGIN / "lib" / "index.js"))
        ).replace(
            "{{HARNESS_PLATFORM_SKILL_DIRS}}", json.dumps([str(path) for path in skill_dirs])
        ).replace(
            "{{HARNESS_PLATFORM_WEBSERVER}}", json.dumps(str(WEB / "lib" / "platform-webserver.mjs"))
        )
    for extension in workspace_extensions():
        target = extension_output(extension, path_only=True)
        result[PLATFORM_PATCH] += ("\n- insert:\n    - id: " + json.dumps(extension["id"])
                                  + "\n      name: " + json.dumps(str(target / "plugin.js"))
                                  + "\n      disabled: false\n")
    return result


def workspace_extensions():
    declared = check_workspace().get("extensions", [])
    if not isinstance(declared, list):
        raise PlatformError("workspace.json extensions 必须是列表。")
    found = set()
    for item in declared:
        if not isinstance(item, dict) or not re.fullmatch(r"[a-z][a-z0-9-]*", item.get("id", "")) or item["id"] in found:
            raise PlatformError("工作区扩展 ID 无效或重复。")
        found.add(item["id"])
        relative = item.get("path")
        if not isinstance(relative, str) or not relative.startswith("extensions/") or ".." in Path(relative).parts:
            raise PlatformError("工作区扩展必须位于数据根 extensions/。")
        directory = (asset_root() / relative).resolve()
        if not directory.is_relative_to(asset_root()) or not (directory / "build.mjs").is_file():
            raise PlatformError("工作区扩展构建入口不存在或超出数据根。")
    return declared


def extension_output(extension, path_only=False):
    command = ["node", str(asset_root() / extension["path"] / "build.mjs")]
    if path_only:
        command.append("--path")
    try:
        result = subprocess.run(command, env=runtime_environment(platform_home()),
                                capture_output=True, text=True, check=True, timeout=120)
        output = Path(result.stdout.strip()).resolve()
        if not output.is_relative_to(asset_root() / ".local/build-cache"):
            raise ValueError()
        return output
    except (OSError, ValueError, subprocess.SubprocessError):
        raise PlatformError(f"扩展 {extension['id']} {'定位' if path_only else '构建'}失败；请检查对应构建入口。") from None


RESEARCH_SKILLS = ("harness-experiment-fusion", "harness-guided-workflow", "harness-evolution", "research-eval", "legacy-asset-intake")


def link_program_asset(target, source, relative):
    """重建已知程序生成链接；保留普通文件、目录与不明来源链接。"""
    if target.is_symlink():
        previous = target.resolve()
        if previous == source:
            return
        parts = Path(relative).parts
        old_program = previous.parents[len(parts) - 1] if len(previous.parts) > len(parts) else None
        if (tuple(previous.parts[-len(parts):]) != parts or old_program is None
                or old_program.exists() and not (old_program / "platform/dsh-platform").is_file()):
            raise PlatformError(f"生成链接来源不明，保留原路径：{target}")
        target.unlink()
    elif target.exists():
        raise PlatformError(f"生成链接位置已被文件或目录占用，保留原路径：{target}")
    target.symlink_to(source, target_is_directory=True)


def prepare_research_skills():
    directory = asset_root() / ".local/build-cache/management-skills"
    directory.mkdir(parents=True, exist_ok=True)
    for name in RESEARCH_SKILLS:
        source = REPO / ".agents/skills" / name
        if not (source / "SKILL.md").is_file():
            raise PlatformError(f"缺少平台复用的研究 Skill：{source}")
        target = directory / name
        link_program_asset(target, source, Path(".agents/skills") / name)


def check_artifacts():
    for name in ("index.js", "client.js", "mcp-manager.js"):
        path = PLUGIN / "lib" / name
        if not path.is_file():
            raise PlatformError(f"缺少插件构建产物：{path}；请先运行 prepare。")
    path = WEB / "lib" / "platform-webserver.mjs"
    if not path.is_file():
        raise PlatformError(f"缺少 Web 基址适配构建产物：{path}；请先运行 prepare。")
    for extension in workspace_extensions():
        if not (extension_output(extension, path_only=True) / "plugin.js").is_file():
            raise PlatformError(f"扩展 {extension['id']} 尚未按当前来源构建；请运行 prepare。")
    for name in RESEARCH_SKILLS:
        target = asset_root() / ".local/build-cache/management-skills" / name
        if not target.is_symlink() or target.resolve() != REPO / ".agents/skills" / name:
            raise PlatformError("平台研究 Skill 未关联当前程序；请运行 prepare。")


def check_profile(profile, rendered):
    bundle = profile / "node_modules" / "@ai-agent-harness" / "harness-platform"
    if not bundle.is_symlink() or bundle.resolve() != PLUGIN:
        raise PlatformError("平台 bundle 未关联到当前仓库；请重新运行 prepare。")
    for name, content in rendered.items():
        path = profile / name
        try:
            actual = path.read_text(encoding="utf-8")
        except OSError as exc:
            raise PlatformError(f"平台 Profile 尚未准备：{path}；请先运行 prepare。") from exc
        if actual != content:
            raise PlatformError(f"平台 Profile 与仓库模板不一致：{path}；请重新运行 prepare。")
    user_patch = profile / "cordis.patch.yml"
    if user_patch.is_file() and normalized_mcp_patch(profile) != user_patch.read_bytes().decode("utf-8"):
        raise PlatformError("原生 MCP 配置仍引用旧 Profile 路径；请运行 prepare 完成身份引用迁移。")


def normalized_mcp_patch(profile):
    """仅重定位原生保存的本平台 MCP 插件 name，保留其余配置的原始字节。"""
    try:
        import yaml
    except ImportError:
        raise PlatformError("检查原生 MCP 配置需要 Python 依赖 PyYAML；请为启动器使用的 Python 安装 PyYAML 后重试。") from None
    patch = profile / "cordis.patch.yml"
    source = patch.read_bytes().decode("utf-8")
    target = profile / "node_modules/@ai-agent-harness/harness-platform/lib/mcp-manager.js"
    # DSH 使用 Node 的 pathToFileURL；其包名中的 @ 保持原样，不能按 Path.as_uri 编码。
    expected = "file://" + quote(str(target.absolute()), safe="/:@!$&'()*+,;=")
    suffix = "/profiles/harness-platform/node_modules/@ai-agent-harness/harness-platform/lib/mcp-manager.js"
    # 原生序列化器可能将长 URL 折为多行。仅组合 YAML 节点，不构造或执行配置标签；
    # 用源码位置替换目标标量，避免重新序列化其余连接、组、凭据和注释。
    try:
        document = yaml.compose(source, Loader=yaml.SafeLoader)
    except yaml.YAMLError:
        raise PlatformError("原生 MCP Patch YAML 格式无效；保留原配置，请先修复。") from None
    if document is None:
        return source
    if not isinstance(document, yaml.SequenceNode):
        raise PlatformError("原生 MCP Patch 必须是 YAML 列表；保留原配置，请先修复。")
    replacements = []
    for row in document.value:
        if not isinstance(row, yaml.MappingNode):
            continue
        fields = {key.value: value for key, value in row.value if isinstance(key, yaml.ScalarNode)}
        identity = fields.get("id")
        if not isinstance(identity, yaml.ScalarNode) or identity.value != "mcp-session-manager":
            continue
        field = fields.get("name")
        if field is None:
            continue
        if not isinstance(field, yaml.ScalarNode) or field.tag != "tag:yaml.org,2002:str":
            raise PlatformError("原生 MCP 插件 name 必须是字符串；保留原配置。")
        name = field.value
        if name == expected:
            continue
        uri = urlparse(name)
        previous = Path(unquote(uri.path))
        if uri.scheme != "file" or uri.netloc or not previous.is_absolute() or not str(previous).endswith(suffix):
            raise PlatformError("原生 MCP 插件身份不属于已知平台 bundle；保留原配置，请核对其来源。")
        if previous.exists() and previous.resolve() != target.resolve():
            raise PlatformError("原生 MCP 插件引用另一份程序；保留原配置，请核对迁移来源。")
        start, end = field.start_mark.index, field.end_mark.index
        if not row.start_mark.index <= start < end <= row.end_mark.index or source[start:end].lstrip().startswith("&"):
            raise PlatformError("原生 MCP 插件 name 使用共享 YAML 引用；保留原配置，请先改为独立字符串。")
        replacements.append((start, end, json.dumps(expected)))
    for start, end, replacement in sorted(replacements, reverse=True):
        source = source[:start] + replacement + source[end:]
    return source


def link_bundle(profile):
    bundle = profile / "node_modules" / "@ai-agent-harness" / "harness-platform"
    bundle.parent.mkdir(parents=True, exist_ok=True)
    link_program_asset(bundle, PLUGIN, Path("platform/plugin"))


def host_value(value):
    try:
        address = ipaddress.IPv4Address(value)
        if address.is_unspecified or address.is_multicast or str(address) == "255.255.255.255":
            raise ValueError()
        return str(address)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("监听地址必须是具体 IPv4 地址，例如 192.168.1.10 或 127.0.0.1。") from exc


def default_host():
    try:
        result = subprocess.run(["ip", "-j", "-4", "route", "get", "1.1.1.1"],
                                capture_output=True, text=True, check=True, timeout=5)
        return host_value(json.loads(result.stdout)[0]["prefsrc"])
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError,
            TypeError, argparse.ArgumentTypeError) as exc:
        raise PlatformError("无法确定本机局域网 IPv4；请通过 --host 指定监听地址。") from exc


def check_port(host, port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
        # 与 Node 监听行为一致，允许停止后的 TIME_WAIT 连接释放端口。
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            listener.bind((host, port))
        except OSError as exc:
            raise PlatformError(f"平台端口不可用：{host}:{port}；请停止占用进程或指定 --port。") from exc


def prepare(home):
    check_workspace()
    executable, version = global_dsh(home)
    rendered = rendered_profile()
    pnpm = shutil.which("pnpm")
    if not pnpm:
        raise PlatformError("PATH 中没有 pnpm；请先安装插件构建工具。")
    if not (PLUGIN / "pnpm-lock.yaml").is_file():
        raise PlatformError(f"缺少插件依赖锁：{PLUGIN / 'pnpm-lock.yaml'}")
    try:
        subprocess.run([pnpm, "install", "--frozen-lockfile"], cwd=PLUGIN, check=True)
        subprocess.run([pnpm, "run", "build"], cwd=PLUGIN, env=runtime_environment(home), check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise PlatformError("插件依赖安装或构建失败；平台 Profile 未更新。") from exc
    for extension in workspace_extensions():
        extension_output(extension)
    prepare_research_skills()
    check_artifacts()
    profile = home / "profiles" / PROFILE_NAME
    profile.mkdir(parents=True, exist_ok=True)
    # 原生用户 Patch 保存 DSH 设置；仓库组合通过独立 overlay 装载。
    user_patch = profile / "cordis.patch.yml"
    if not user_patch.exists():
        user_patch.write_text("[]\n", encoding="utf-8")
    # 在重建 bundle 链接前核对旧 MCP 身份，旧 HOME 必须指向恢复出的同一程序。
    # 换链后再核对会丢失该来源关系，导致合法的程序与数据同时迁移被拒绝。
    normalized = normalized_mcp_patch(profile)
    link_bundle(profile)
    for name, content in rendered.items():
        (profile / name).write_text(content, encoding="utf-8")
    if normalized != user_patch.read_bytes().decode("utf-8"):
        temporary = user_patch.with_name(f".cordis.patch.{os.getpid()}.tmp")
        with temporary.open("x", encoding="utf-8") as handle:
            os.chmod(temporary, user_patch.stat().st_mode & 0o777)
            handle.write(normalized)
        temporary.replace(user_patch)
    print(f"平台准备完成：DSH {version} ({executable})")
    print(f"Profile：{profile}")
    print("启动：./platform/dsh-platform start")


def bootstrap_state():
    node = shutil.which("node")
    if not node:
        raise PlatformError("初始化检查需要 Node.js 24 或更新版本；请安装后将 node 加入 PATH。")
    try:
        result = subprocess.run([node, str(REPO / "platform/bootstrap/server.ts"), "--check", str(asset_root())],
                                capture_output=True, text=True, check=True, timeout=15)
        return json.loads(result.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        raise PlatformError("无法检查数据工作区；请核对 Node.js 24、Git 与数据目录读取权限。") from None


def initialize_from_browser(host, port):
    check_port(host, port)
    with tempfile.TemporaryDirectory(prefix="harness-platform-initialize-") as temporary:
        result_file = Path(temporary) / "result.json"
        access_file = Path(temporary) / "access-url"
        token = secrets.token_urlsafe(32)
        url = f"http://{host}:{port}/hep/?bootstrap={token}"
        access_file.write_text(url + "\n", encoding="utf-8")
        access_file.chmod(0o600)
        print("平台数据工作区尚未就绪，已进入初始化引导。", flush=True)
        if sys.stdout.isatty():
            print(f"一次性初始化入口：{url}", flush=True)
        else:
            print(f"一次性初始化入口已保存到仅当前用户可读的文件：{access_file}", flush=True)
        options = {"root": str(asset_root()), "host": host, "port": port, "token": token,
                   "resultFile": str(result_file), "programRoot": str(REPO), "python": sys.executable}
        result = subprocess.run([shutil.which("node"), str(REPO / "platform/bootstrap/server.ts")],
                                env={**os.environ, "HARNESS_BOOTSTRAP_OPTIONS": json.dumps(options)})
        if result.returncode != 0 or not result_file.is_file():
            raise PlatformError("初始化未完成；未启动平台，已创建的数据会保留供下次接续。")
        selected = json.loads(result_file.read_text(encoding="utf-8"))["root"]
        if not isinstance(selected, str) or not Path(selected).is_absolute():
            raise PlatformError("初始化返回的数据根无效。")
        os.environ["HARNESS_ASSET_ROOT"] = selected


def start(home, host, port, dry_run):
    state = bootstrap_state()
    if not state["ready"]:
        host = host or default_host()
        if dry_run:
            print(json.dumps({"mode": "initialization", "asset_root": str(asset_root()),
                              "base_url": f"http://{host}:{port}/hep/", "checks": state["checks"]}, ensure_ascii=False, indent=2))
            return
        initialize_from_browser(host, port)
        home = platform_home()
    workspace = check_workspace()
    executable, version = global_dsh(home)
    rendered = rendered_profile()
    check_artifacts()
    profile = home / "profiles" / PROFILE_NAME
    check_profile(profile, rendered)
    host = host or default_host()
    check_port(host, port)
    # Launcher 选项必须先于 Web app 选项，否则 DSH 会将其透传给 Web。
    command = [executable, "--profile", PROFILE_NAME, "--patch", str(profile / PLATFORM_PATCH),
               "--host", host, "--port", str(port), "--no-open"]
    if dry_run:
        print(json.dumps({
            "repository": str(REPO), "asset_root": str(asset_root()), "workspace_id": workspace["id"],
            "dsh": executable, "dsh_version": version,
            "home": str(home), "profile": str(profile),
            "patch": str(profile / PLATFORM_PATCH),
            "plugin": str(PLUGIN / "lib" / "index.js"),
            "client": str(PLUGIN / "lib" / "client.js"),
            "webserver": str(WEB / "lib" / "platform-webserver.mjs"),
            "base_url": f"http://{host}:{port}{base_path()}",
            "host": host, "port": port, "command": command,
        }, ensure_ascii=False, indent=2))
        return
    print(f"平台地址：http://{host}:{port}{base_path()}（打开页面登录）", flush=True)
    print("前台运行；Ctrl+C 停止，重启复用同一平台 HOME。", flush=True)
    os.chdir(asset_root())
    os.execvpe(executable, command, {**runtime_environment(home),
                                  "HARNESS_DSH_ENTRY": str(Path(executable).resolve())})


def port_value(value):
    try:
        port = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("端口必须是 1 至 65535 的整数。") from exc
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("端口必须是 1 至 65535 的整数。")
    return port


def main():
    if sys.version_info < (3, 10):
        print("dsh-platform: 需要 Python 3.10 或更新版本；请用兼容解释器运行本入口。", file=sys.stderr)
        return 1
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("prepare", help="安装插件构建依赖、构建并生成独立平台 Profile")
    start_parser = commands.add_parser("start", help="使用全局 DSH 前台启动平台")
    start_parser.add_argument("--port", type=port_value, default=3090, help="监听端口，默认 3090")
    start_parser.add_argument("--host", type=host_value, help="监听 IPv4，默认选择本机局域网地址")
    start_parser.add_argument("--dry-run", action="store_true", help="只读检查并预览启动参数")
    args = parser.parse_args()
    try:
        home = platform_home()
        if args.command == "prepare":
            prepare(home)
        else:
            start(home, args.host, args.port, args.dry_run)
    except (PlatformError, OSError) as exc:
        print(f"dsh-platform: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
