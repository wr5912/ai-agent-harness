{
  "$id": "response-plan-input/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmed_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_ref": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "maxLength": 512,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "statement": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "evidence_ref",
          "statement"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "eligible_published_candidates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "playbook_id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "summary": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "playbook_id",
              "summary"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "eligible_temporary_actions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action_key": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "parameters": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "maxLength": 128,
                      "minLength": 1,
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "type": "object"
                },
                "maxItems": 256,
                "type": "array",
                "uniqueItems": true
              },
              "target": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action_key",
              "target",
              "parameters"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "published_semantic_selection",
            "temporary_action_composition"
          ]
        },
        "success_criteria": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "eligible_published_candidates",
        "eligible_temporary_actions",
        "success_criteria"
      ],
      "type": "object"
    },
    "incident_summary": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "requested_output": {
      "const": "response-plan-output/v1"
    },
    "schema_version": {
      "const": "response-plan-input/v1"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "incident_summary",
    "confirmed_evidence",
    "constraints",
    "requested_output"
  ],
  "title": "Response Plan Input v1",
  "type": "object"
}
