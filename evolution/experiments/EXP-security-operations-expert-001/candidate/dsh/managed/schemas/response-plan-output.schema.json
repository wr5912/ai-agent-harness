{
  "$id": "response-plan-output/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "plan": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "published_reuse"
              }
            },
            "required": [
              "resolution"
            ]
          },
          "then": {
            "properties": {
              "selected_playbook_id": {
                "type": "string"
              },
              "steps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "temporary"
              }
            },
            "required": [
              "resolution"
            ]
          },
          "then": {
            "properties": {
              "selected_playbook_id": {
                "type": "null"
              },
              "steps": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "needs_human_review"
              }
            },
            "required": [
              "resolution"
            ]
          },
          "then": {
            "properties": {
              "selected_playbook_id": {
                "type": "null"
              },
              "steps": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "decision_reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "resolution": {
          "enum": [
            "published_reuse",
            "temporary",
            "needs_human_review"
          ]
        },
        "selected_playbook_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action_key": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "parameters": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "maxLength": 128,
                      "minLength": 1,
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "type": "object"
                },
                "maxItems": 256,
                "type": "array",
                "uniqueItems": true
              },
              "reason": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "target": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action_key",
              "target",
              "parameters",
              "reason"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "resolution",
        "decision_reason",
        "selected_playbook_id",
        "steps"
      ],
      "type": "object"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "risks": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "response-plan-output/v1"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "plan",
    "assumptions",
    "risks",
    "evidence_refs"
  ],
  "title": "Response Plan Output v1",
  "type": "object"
}
