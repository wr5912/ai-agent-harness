def project_containers(name: str) -> list[dict] | None:
    """查询本实例实际容器状态；查询失败返回 None，由调用方按未知处理。"""
    listing = run(
        ["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project_name(name)}",
         "--format", "{{.ID}}\t{{.State}}\t{{.Status}}\t{{.Names}}\t{{.Label \"com.docker.compose.service\"}}"],
        check=False,
    )
    if listing.returncode != 0:
        return None
    containers = []
    for line in (listing.stdout or "").strip().splitlines():
        fields = line.split("\t")
        if len(fields) != 5:
            return None
        containers.append({"id": fields[0], "state": fields[1], "status": fields[2],
                           "name": fields[3], "service": fields[4]})
    return containers


def wait_for_service(name: str, service: str, timeout: float = 20.0) -> list[dict] | None:
    """等待指定服务进入运行状态；超时返回最后一次观测，无法查询返回 None。"""
    deadline = time.monotonic() + timeout
    while True:
        containers = project_containers(name)
        if containers is None:
            return None
        if any(item["service"] == service and item["state"] == "running" for item in containers):
            return containers
        if time.monotonic() >= deadline:
            return containers
        time.sleep(1.0)


def home_volume(manifest: dict) -> tuple[str | None, bool | None]:
    """按 Compose 自身的卷标签解析本实例 HOME 卷，返回 (卷名, 是否存在)。

    Compose 会把项目名前缀加到卷名上，因此不能按模板里的声明名或 `<project>-home` 猜测；
    查询失败返回 (None, None)，由调用方按未知处理。
    """
    declared = f"{manifest['project']}-home"
    listing = run(["docker", "volume", "ls",
                   "--filter", f"label=com.docker.compose.project={manifest['project']}",
                   "--filter", f"label=com.docker.compose.volume={declared}",
                   "--format", "{{.Name}}"], check=False)
    if listing.returncode != 0:
        return None, None
    names = [line for line in (listing.stdout or "").split() if line]
    if not names:
        return declared, False
    return names[0], True


def command_down(args: argparse.Namespace) -> None:
    """停止实例并如实报告结果：命令失败、仍有容器运行或状态未知都不报告停止成功。"""
    target = instance_dir(args.name)
    if not (target / "instance.json").is_file():
        fail(f"未找到实例 {args.name}")
    manifest = json.loads((target / "instance.json").read_text(encoding="utf-8"))
    completed = run(compose_command(target, args.name, "down", "--remove-orphans"),
                    check=False, env=instance_compose_env(manifest))
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip()
        fail(f"停止 {args.name} 失败（docker compose down 退出码 {completed.returncode}），实例状态未确认：{detail[-400:]}")
    containers = project_containers(args.name)
    resolved_volume, preserved = home_volume(manifest)
    report = {
        "name": args.name,
        "project": manifest["project"],
        "home_volume": resolved_volume,
        "home_preserved": preserved,
    }
    if containers is None:
        report["stopped"] = "unknown"
        report["detail"] = "docker ps 查询失败，无法确认实例是否已停止；不报告停止成功"
        print(json.dumps(report, ensure_ascii=False))
        raise SystemExit(1)
    running = [item for item in containers if item["state"] == "running"]
    report["containers"] = containers
    report["stopped"] = not running
    report["containers_removed"] = not containers
    print(json.dumps(report, ensure_ascii=False))
    if running:
        fail("docker compose down 返回 0，但以下容器仍在运行：" + "、".join(item["name"] for item in running))


def command_image_build(args: argparse.Namespace) -> None:
    script = ADAPTER / "build-image.sh"
    if shutil.which("bash") is None:
        fail("缺少 bash，无法调用 build-image.sh")
    run(["bash", str(script), "--source", args.source], check=True, capture=False)
    print(json.dumps({"built": True, "source": args.source}, ensure_ascii=False))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    build = commands.add_parser("image", help="构建锁定 DSH 镜像")
    build_sub = build.add_subparsers(dest="image_command", required=True)
    build_parser = build_sub.add_parser("build")
    build_parser.add_argument("--source", default="EXP-security-operations-expert-001")
    build_parser.set_defaults(handler=command_image_build)

    for name, handler, needs_source in (
        ("plan", command_plan, True),
        ("up", command_up, True),
    ):
        sub = commands.add_parser(name, help="实例计划或启动")
        if needs_source:
            sub.add_argument("--source", required=True, help="experiment:<id> 或 snapshot:<snap-id>")
        sub.add_argument("--mode", choices=MODE_CHOICES, required=True, type=normalize_mode,
                         help="dev（开发模式/创造模式，内部 authoring）或 eval（评测模式，内部 verification）")
        sub.add_argument("--name", required=True)
        sub.add_argument("--port", type=int, required=True)
        if name == "up":
            sub.add_argument("--allow-missing-env", action="store_true",
                             help="显式允许缺少运行时环境变量，仅用于技术装载核验")
            sub.add_argument("--accept-cordis-trust", action="store_true",
                             help="显式确认开发模式（Cordis 创造模式）等同 shell 权限与 host 网络风险")
        sub.set_defaults(handler=handler)

    commands.add_parser("ps", help="列出启动器管理的实例").set_defaults(handler=command_ps)

    url_parser = commands.add_parser("url", help="取得本次进程的认证 URL")
    url_parser.add_argument("name")
    url_parser.add_argument("--non-interactive", action="store_true",
                            help="允许向非交互标准输出打印认证 URL（含敏感值，调用方自负保护责任）")
    url_parser.set_defaults(handler=command_url)

    logs_parser = commands.add_parser("logs", help="输出有界、尽力脱敏的运行日志")
    logs_parser.add_argument("name")
    logs_parser.add_argument("--tail", type=int, default=200)
    logs_parser.set_defaults(handler=command_logs)

    down_parser = commands.add_parser("down", help="停止实例并保留 HOME")
    down_parser.add_argument("name")
    down_parser.set_defaults(handler=command_down)

    args = parser.parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
