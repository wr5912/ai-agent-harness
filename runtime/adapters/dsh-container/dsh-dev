#!/usr/bin/env python3
"""dsh-dev：按来源选择器启动本地 DSH 容器实例，并交付本次进程的认证 URL。

设计合同见 docs/DSH容器开发启动器设计方案.md。本工具只依赖 Python 3 标准库、
Docker CLI 与 Compose；实例配置生成在仓库外，Token 不落盘、不入仓库、不回显到日志。
"""

from __future__ import annotations

import argparse
import http.cookiejar
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from source_contract import REPO, resolve  # noqa: E402

ADAPTER = Path(__file__).resolve().parent
STATE_ROOT = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "dsh-dev"
NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
TOKEN_URL_RE = re.compile(r"dsh web: (http://127\.0\.0\.1:(\d+)/\?token=[^\s()]+)")
SECRET_RE = re.compile(r"(token=)[^\s&)\"']+")
MODES = ("authoring", "verification")
MODE_ALIASES = {"dev": "authoring", "eval": "verification"}
MODE_CHOICES = ("dev", "eval") + MODES
PURPOSES = {"authoring": "dev", "verification": "eval"}
# 开发模式用出厂 cordis（创造模式），它是 Runtime 固定事实；评测模式的目标 preset 由所选来源声明决定，
# 不在通用启动器里硬编码任何业务 Agent 名。
AUTHORING_PRESET = "cordis"
CONTEXT_ASSETS = (
    ("spec", "/work/spec", "spec_root", "需求定义、任务定义、验收标准"),
    ("eval", "/work/eval-reference", "eval_root", "测试数据、评估方法、待复核输入"),
)
CORDIS_TRUST_NOTICE = (
    "开发模式（--mode dev）以出厂 cordis（创造模式）preset 启动：该会话具备 shell 与对实时 runtime 执行模型 JS 的 "
    "tool-cordis 能力，等同 shell 权限；容器使用 host 网络，可直达宿主回环服务（含本机 DSH Web）；"
    "创造模式会话不加载 security-operations-guard，注入的 SOC MCP 工具与 delegate 不受角色矩阵约束。"
)
CONTAINER_WORKSPACE = "/work/harness/workspace"
# 开发会话注册 /work：受控只读的 /work/AGENTS.md 说明开发者身份与可编辑范围，
# 目标智能体的业务 AGENTS.md 仍留在 /work/harness/workspace 供阅读和编辑，但不会被注入为会话身份。
CONTAINER_DEV_WORKSPACE = "/work"
CONTAINER_SPEC = "/work/spec"
CONTAINER_EVAL_REFERENCE = "/work/eval-reference"
# 受控模板不含任何仓库内默认值，凡读取实例 Compose 的命令都必须按实例状态注入这些变量。
INSTANCE_SCHEMA_VERSION = "1.2"
# DSH Web 首次打开是冷启动：会话必须先绑定一个**已注册工作区**，而新实例的 DSH_HOME 里工作区注册表为空
# （注册表 storages/workspace.json 只从已存会话头 bootstrap，且初始化标记一经写入不再重建）。DSH 在该锁定提交上
# 没有受支持的工作区预注册入口，因此启动器只如实交付路径与操作步骤，不改写 Runtime 存储内部格式。
def web_cold_start_hint(mode: str) -> str:
    path = workspace_to_register(mode)
    return (
        "DSH Web 首次打开需要在界面注册工作区：点击“选择工作区”→ 目录对话框的“编辑路径”→ 粘贴 "
        f"“{path}” → “打开”，随后即可直接对话。该注册写入本实例 DSH_HOME 数据卷并跨重启保留；"
        "换用新的实例名等于新的 HOME 卷，需要重新选择一次。"
    )


def fail(message: str) -> None:
    print(f"dsh-dev failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def normalize_mode(value: str) -> str:
    """把用户可见模式名（dev/eval）规范化为内部 harness 阶段名。"""
    mode = MODE_ALIASES.get(value, value)
    if mode not in MODES:
        fail("mode 只能是 dev、eval、authoring 或 verification")
    return mode


def workspace_to_register(mode: str) -> str:
    """本次会话要注册的工作区：开发会话用 /work，被测会话用目标 Harness 工作区本身。"""
    return CONTAINER_DEV_WORKSPACE if mode == "authoring" else CONTAINER_WORKSPACE


def target_preset(contract: dict, mode: str) -> str:
    """本次会话实际运行的 preset ID：开发模式用创造模式，评测模式用来源声明的目标。"""
    if mode == "authoring":
        return AUTHORING_PRESET
    preset = contract.get("preset_id")
    if not preset:
        fail("所选来源未声明可解析的 preset ID，无法确定评测目标")
    return preset


def context_assets(contract: dict, mode: str) -> list[dict]:
    """只读上下文数据资产。

    开发模式是开发者会话，挂载需求与评测材料用于修改和核对；评测模式运行的是被测目标，
    不挂载任何判分材料 —— 验收阈值、评估方法、测试预置与预期答案都属于判分侧。
    """
    if mode != "authoring":
        return []
    missing = [key for _, _, key, _ in CONTEXT_ASSETS if not contract.get(key)]
    if missing:
        fail("所选来源缺少只读上下文数据资产根（%s）；不伪造空目录，请改用具备 spec/eval 的来源" % "、".join(missing))
    return [
        {"key": name, "host": contract[key], "container": container, "mode": "ro", "content": content}
        for name, container, key, content in CONTEXT_ASSETS
    ]


def run(command: list[str], *, check: bool = True, capture: bool = True, env: dict | None = None) -> subprocess.CompletedProcess:
    completed = subprocess.run(
        command, text=True, capture_output=capture, check=False, env=env, timeout=300
    )
    if check and completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip()
        fail(f"命令失败（{command[0]}）：{detail[-400:]}")
    return completed


def compose_env(contract: dict, mode: str, port: int) -> dict:
    environment = dict(os.environ)
    environment.update(
        {
            "DSH_IMAGE_TAG": contract["image"]["local_image_tag"],
            "DSH_ADAPTER_HOST": str(ADAPTER),
            "DSH_MANAGED_PATCH": contract["patch"],
            "DSH_WORKSPACE_HOST": contract["workspace"],
            "DSH_PRESETS_HOST": contract["presets"],
            "DSH_MANAGED_HOST": contract["managed"],
        }
    )
    for asset in context_assets(contract, mode):
        environment["DSH_SPEC_HOST" if asset["key"] == "spec" else "DSH_EVAL_HOST"] = asset["host"]
    if mode == "authoring":
        if not contract.get("patch_overlay"):
            fail("所选来源未登记开发模式叠加层（development_patch_overlay），不能以 --mode dev 启动")
        environment["DSH_MANAGED_PATCH_OVERLAY"] = contract["patch_overlay"]
    return environment


def required_env_names(contract: dict) -> list[str]:
    names = list(contract.get("required_env_names") or [])
    return names


def check_environment(contract: dict) -> None:
    missing = [name for name in required_env_names(contract) if not os.environ.get(name)]
    if missing:
        fail(
            "以下运行时环境变量未注入，按 fail-closed 拒绝启动："
            + "、".join(missing)
            + "（由受信调用环境按名注入；本工具不读取凭据文件）"
        )


def render_compose(template: str, *, mode: str, project: str, port: int) -> str:
    """把受控 Compose 模板渲染为实例配置：宿主网络、回环端口、每实例卷名。"""
    if mode not in MODES:
        fail("mode 只能是 authoring 或 verification")
    text = template
    replacements = [
        (f"name: ai-agent-harness-dsh-{mode}", f"name: {project}"),
        (f"dsh-{mode}-home", f"{project}-home"),
        (f"dsh-{mode}-trusted-fallback", f"{project}-fallback"),
    ]
    for old, new in replacements:
        if text.count(old) < 1:
            fail(f"Compose 模板缺少预期锚点：{old}")
        text = text.replace(old, new)
    working_dir = "    working_dir: /work/harness/workspace\n"
    if text.count(working_dir) != 1:
        fail("Compose 模板缺少唯一的 working_dir 锚点")
    text = text.replace(working_dir, working_dir + "    network_mode: host\n")
    relative_source = "        source: ./"
    if text.count(relative_source) < 1:
        fail("Compose 模板缺少相对挂载源锚点")
    text = text.replace(relative_source, f"        source: {ADAPTER}/")
    command_tail = "      - --no-open\n"
    if text.count(command_tail) != 1:
        fail("Compose 模板缺少唯一的 command 锚点")
    text = text.replace(
        command_tail,
        command_tail + f"      - --host\n      - 127.0.0.1\n      - --port\n      - \"{port}\"\n",
    )
    return text


def extract_auth_url(log_text: str, port: int) -> str | None:
    """从日志中提取唯一匹配本次端口与本机回环的认证 URL。"""
    matches = [match for match in TOKEN_URL_RE.finditer(log_text) if int(match.group(2)) == port]
    if not matches:
        return None
    urls = {match.group(1) for match in matches}
    if len(urls) != 1:
        return None
    return urls.pop()


def redact_secrets(text: str) -> str:
    return SECRET_RE.sub(r"\1<redacted>", text)


def instance_dir(name: str) -> Path:
    if not NAME_RE.fullmatch(name):
        fail("实例名必须使用小写 kebab-case")
    return STATE_ROOT / name


def project_name(name: str) -> str:
    return f"dsh-dev-{name}"


def write_instance(name: str, *, mode: str, contract: dict, port: int,
                   accepted_cordis_trust: bool = False) -> Path:
    target = instance_dir(name)
    if target.exists():
        manifest = target / "instance.json"
        if manifest.is_file():
            existing = json.loads(manifest.read_text(encoding="utf-8"))
            if existing.get("source_id") != contract["source_id"] or existing.get("mode") != mode:
                fail(
                    f"实例 {name} 已存在且来源/模式不同（{existing.get('source_id')}/{existing.get('mode')}）；"
                    "请改用新的实例名"
                )
        else:
            fail(f"实例目录已存在但缺少 instance.json：{target}")
    else:
        target.mkdir(parents=True, exist_ok=False)
    template = (ADAPTER / f"{mode}.compose.yaml").read_text(encoding="utf-8")
    rendered = render_compose(template, mode=mode, project=project_name(name), port=port)
    (target / "compose.yaml").write_text(rendered, encoding="utf-8")
    manifest = {
        "schema_version": INSTANCE_SCHEMA_VERSION,
        "name": name,
        "project": project_name(name),
        "source_id": contract["source_id"],
        "source_kind": contract["source_kind"],
        "mode": mode,
        "purpose": PURPOSES[mode],
        "target_preset": target_preset(contract, mode),
        "port": port,
        "image_tag": contract["image"]["local_image_tag"],
        "adapter_root": str(ADAPTER),
        "managed_patch": contract["patch"],
        "agent_id": contract["agent_id"],
        "mounts": {
            "workspace": contract["workspace"],
            "presets": contract["presets"],
            "managed": contract["managed"],
        },
        "context_mounts": [
            {"key": asset["key"], "host": asset["host"], "container": asset["container"], "mode": asset["mode"]}
            for asset in context_assets(contract, mode)
        ],
        "mount_modes": {
            "workspace": "rw" if mode == "authoring" else "ro",
            "presets": "ro",
            "managed": "ro",
        },
        "patch_overlay": contract.get("patch_overlay") if mode == "authoring" else None,
        "cordis_trust_accepted": bool(accepted_cordis_trust) if mode == "authoring" else False,
        "required_env_names": required_env_names(contract),
    }
    (target / "instance.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    return target


def instance_compose_env(manifest: dict) -> dict:
    """从实例状态重建读取该实例 Compose 所需的环境。

    模板用 ${VAR:?} 声明必填变量（不内联任何仓库内默认路径），所以 `ps`、`logs`、`down`
    也必须按实例自身记录注入，不能依赖调用者的当前环境——否则停止和查询会随环境漂移而失败。
    """
    if manifest.get("schema_version") != INSTANCE_SCHEMA_VERSION:
        fail(
            "实例状态文件版本过旧（%s），缺少读取其 Compose 所需的字段；"
            "请对同名实例重新执行 up（HOME 数据卷保留）" % manifest.get("schema_version")
        )
    mounts = manifest.get("mounts") or {}
    environment = dict(os.environ)
    environment.update(
        {
            "DSH_IMAGE_TAG": manifest["image_tag"],
            "DSH_ADAPTER_HOST": manifest["adapter_root"],
            "DSH_MANAGED_PATCH": manifest["managed_patch"],
            "DSH_WORKSPACE_HOST": mounts["workspace"],
            "DSH_PRESETS_HOST": mounts["presets"],
            "DSH_MANAGED_HOST": mounts["managed"],
        }
    )
    if manifest.get("patch_overlay"):
        environment["DSH_MANAGED_PATCH_OVERLAY"] = manifest["patch_overlay"]
    for asset in manifest.get("context_mounts", []):
        key = "DSH_SPEC_HOST" if asset["container"] == CONTAINER_SPEC else "DSH_EVAL_HOST"
        environment[key] = asset["host"]
    return environment


def compose_command(target: Path, name: str, *args: str) -> list[str]:
    return ["docker", "compose", "-p", project_name(name), "-f", str(target / "compose.yaml"), *args]


def load_instance(name: str) -> tuple[Path, dict]:
    target = instance_dir(name)
    manifest_path = target / "instance.json"
    if not manifest_path.is_file():
        fail(f"未找到实例 {name} 的状态文件；先执行 dsh-dev up")
    return target, json.loads(manifest_path.read_text(encoding="utf-8"))


def port_in_use(port: int) -> bool:
    """以 TCP 连接探测宿主回环端口是否已被占用。"""
    import socket

    probe = socket.socket()
    probe.settimeout(1.0)
    try:
        probe.connect(("127.0.0.1", port))
    except OSError:
        return False
    finally:
        probe.close()
    return True


def command_plan(args: argparse.Namespace) -> None:
    if not 1 <= args.port <= 65535:
        fail("--port 必须是合法 TCP 端口")
    contract = resolve(args.source, repo=REPO)
    if args.mode == "authoring" and contract["source_kind"] != "experiment":
        fail("开发模式（authoring）只接受 experiment:<id> 来源；该来源必须可写才能作为开发目标")
    assets = context_assets(contract, args.mode)
    missing = [name for name in required_env_names(contract) if not os.environ.get(name)]
    plan = {
        "schema_version": "1.0",
        "name": args.name,
        "project": project_name(args.name),
        "mode": args.mode,
        "purpose": PURPOSES[args.mode],
        "target_preset": target_preset(contract, args.mode),
        "workspace_to_register": workspace_to_register(args.mode),
        "grading_material_mounted": args.mode == "authoring",
        "port": args.port,
        "source_id": contract["source_id"],
        "source_kind": contract["source_kind"],
        "image_tag": contract["image"]["local_image_tag"],
        "mounts": [
            {"container": "/work/harness/workspace", "mode": "rw" if args.mode == "authoring" else "ro"},
            {"container": "/opt/dsh-presets", "mode": "ro"},
            {"container": "/opt/dsh-managed", "mode": "ro"},
            *[{"container": asset["container"], "mode": "ro", "content": asset["content"]} for asset in assets],
        ],
        "context_assets": assets,
        "workspace_to_register": workspace_to_register(args.mode),
        "web_cold_start": web_cold_start_hint(args.mode),
        "patch_overlay": contract.get("patch_overlay") if args.mode == "authoring" else None,
        "cordis_trust_required": args.mode == "authoring",
        "dev_instructions": "/work/AGENTS.md" if args.mode == "authoring" else None,
        "network": "host (127.0.0.1 only)",
        "required_env_names": required_env_names(contract),
        "missing_env_names": missing,
        "state_dir": str(instance_dir(args.name)),
        "risk": "host 网络取消容器与宿主机的网络命名空间隔离；实例只绑定 127.0.0.1",
    }
    if args.mode == "authoring":
        plan["cordis_trust_notice"] = CORDIS_TRUST_NOTICE
    if args.mode == "verification" and contract["source_kind"] == "experiment":
        plan["evaluation_source_notice"] = "评测模式绑定的是可变宿主候选（非冻结副本）；该结果只能作为局部技术核验，不得作为正式评估结论。"
    print(json.dumps(plan, ensure_ascii=False, indent=2, sort_keys=True))


def command_up(args: argparse.Namespace) -> None:
    if not 1 <= args.port <= 65535:
        fail("--port 必须是合法 TCP 端口")
    if port_in_use(args.port):
        fail(f"端口 {args.port} 已被占用；本工具不自动改端口，请显式指定其它端口")
    contract = resolve(args.source, repo=REPO)
    if args.mode == "authoring" and contract["source_kind"] != "experiment":
        fail("开发模式（authoring）只接受 experiment:<id> 来源；该来源必须可写才能作为开发目标")
    if args.mode == "authoring" and not args.accept_cordis_trust:
        fail(CORDIS_TRUST_NOTICE + " 确认接受上述风险后，重新执行并显式加 --accept-cordis-trust。")
    if args.mode != "authoring" and args.accept_cordis_trust:
        fail("--accept-cordis-trust 只对开发模式（--mode dev / authoring）有效")
    context_assets(contract, args.mode)
    if args.allow_missing_env:
        missing = [name for name in required_env_names(contract) if not os.environ.get(name)]
        if missing:
            print(json.dumps({"warning": "缺少运行时环境变量，按显式降级启动（仅技术装载核验）",
                              "missing_env_names": missing}, ensure_ascii=False), file=sys.stderr)
    else:
        check_environment(contract)
    target = write_instance(args.name, mode=args.mode, contract=contract, port=args.port,
                            accepted_cordis_trust=args.accept_cordis_trust)
    environment = compose_env(contract, args.mode, args.port)
    run(compose_command(target, args.name, "config", "--quiet"), env=environment)
    run(compose_command(target, args.name, "up", "-d", "--no-build"), env=environment)
    # `docker compose up -d` 返回 0 只说明命令成功，不说明容器在运行：容器可能立刻退出。
    containers = wait_for_service(args.name, "dsh")
    report = {"name": args.name, "project": project_name(args.name), "port": args.port,
              "state_dir": str(target)}
    if containers is None:
        report["dsh_running"] = "unknown"
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
        fail("无法查询容器状态，不能确认 dsh 服务是否已启动；用 logs 查看实例日志")
    running = [item for item in containers if item["service"] == "dsh" and item["state"] == "running"]
    report["dsh_running"] = bool(running)
    report["containers"] = [{"service": item["service"], "state": item["state"]} for item in containers]
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    if not running:
        fail("docker compose up 返回 0，但 dsh 服务没有进入运行状态；用 logs 查看失败原因")
    print(json.dumps({"hint": web_cold_start_hint(args.mode), "workspace_to_register": workspace_to_register(args.mode)},
                     ensure_ascii=False), file=sys.stderr)


def command_ps(_args: argparse.Namespace) -> None:
    entries = []
    if STATE_ROOT.is_dir():
        for target in sorted(STATE_ROOT.iterdir()):
            manifest_path = target / "instance.json"
            if not manifest_path.is_file():
                continue
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            listing = run(compose_command(target, manifest["name"], "ps", "--format", "json"),
                          check=False, env=instance_compose_env(manifest))
            if listing.returncode != 0:
                ps_state = "unknown"
                ps_detail = (listing.stderr or listing.stdout or "").strip()[-200:] or "docker compose ps 查询失败"
            else:
                ps_state = "reported"
                ps_detail = (listing.stdout or "").strip() or "not running"
            entries.append(
                {
                    "name": manifest["name"],
                    "source_id": manifest["source_id"],
                    "mode": manifest["mode"],
                    "purpose": manifest.get("purpose", PURPOSES.get(manifest["mode"], manifest["mode"])),
                    "target_preset": manifest.get("target_preset"),
                    "port": manifest["port"],
                    "context_mounts": [item["container"] for item in manifest.get("context_mounts", [])],
                    "base_url": f"http://127.0.0.1:{manifest['port']}/",
                    "ps_query": ps_state,
                    "ps": ps_detail,
                }
            )
    print(json.dumps({"schema_version": "1.0", "instances": entries}, ensure_ascii=False, indent=2, sort_keys=True))


def running_container(name: str) -> tuple[str, str]:
    project = project_name(name)
    listing = run(["docker", "ps", "--filter", f"label=com.docker.compose.project={project}",
                   "--format", "{{.ID}}"], check=False)
    containers = (listing.stdout or "").strip().splitlines()
    if not containers:
        fail(f"实例 {name} 没有运行中的容器")
    container = containers[0]
    inspect = run(["docker", "inspect", "--format", "{{.State.StartedAt}}", container])
    return container, inspect.stdout.strip()


def command_url(args: argparse.Namespace) -> None:
    _, manifest = load_instance(args.name)
    if not args.non_interactive and not sys.stdout.isatty():
        fail(
            "标准输出不是交互终端；认证 URL 含本次进程 Token。"
            "确需由脚本或 IDE 消费时显式加 --non-interactive，并自行保护标准输出"
        )
    container, started_at = running_container(args.name)
    logs = run(["docker", "logs", "--since", started_at, container], check=False).stdout or ""
    url = extract_auth_url(logs, manifest["port"])
    if url is None:
        fail("未从本次进程日志中取得唯一的认证 URL（不返回历史链接，也不拼造 Token）")
    probe = probe_url(url, manifest["port"])
    if not probe["ok"]:
        fail(f"认证 URL 探针失败：{probe['reason']}")
    if args.non_interactive:
        print("警告：标准输出含本次进程认证 URL（敏感），调用方负责管道与终端记录。", file=sys.stderr)
    print(url)


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """禁止自动跟随重定向：Token 入口的 303 本身就是核验证据，不能被吞成 200。"""

    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        return None


def probe_url(url: str, port: int) -> dict:
    jar = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(
        urllib.request.HTTPCookieProcessor(jar), NoRedirectHandler()
    )
    try:
        request = urllib.request.Request(url, method="GET")
        try:
            with opener.open(request, timeout=20) as response:
                status = response.status
        except urllib.error.HTTPError as error:
            status = error.code
            error.close()
        if status not in (200, 301, 302, 303, 307, 308):
            return {"ok": False, "reason": f"Token 入口返回意外状态（HTTP {status}）"}
        if not any(cookie.name for cookie in jar):
            return {"ok": False, "reason": f"Token 入口未建立会话 Cookie（HTTP {status}）"}
        root = f"http://127.0.0.1:{port}/"
        try:
            with opener.open(urllib.request.Request(root, method="GET"), timeout=20) as response:
                root_status = response.status
                html = response.read(65536).decode("utf-8", "replace")
        except urllib.error.HTTPError as error:
            error.close()
            return {"ok": False, "reason": f"认证后根页面 HTTP {error.code}"}
        if root_status != 200:
            return {"ok": False, "reason": f"认证后根页面 HTTP {root_status}"}
        if "__DSH_BOOT__" not in html:
            return {"ok": False, "reason": "根页面缺少 __DSH_BOOT__"}
        return {"ok": True, "reason": f"token({status})→cookie→root 200"}
    except (urllib.error.URLError, OSError, ValueError) as error:
        return {"ok": False, "reason": f"{type(error).__name__}"}


def command_logs(args: argparse.Namespace) -> None:
    target, manifest = load_instance(args.name)
    logs = run(compose_command(target, args.name, "logs", "--no-color", "--tail", str(args.tail), "dsh"),
               env=instance_compose_env(manifest)).stdout or ""
